<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="PreferencesDialog" parent="AdwPreferencesDialog">
    <property name="search-enabled">True</property>
    <child>
      <object class="AdwPreferencesPage">
        <property name="icon_name">preferences-window-layout-symbolic</property>
        <property name="title" translatable="yes">General</property>
        <property name="use-underline">True</property>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">User Interface</property>
            <child>
              <object class="AdwComboRow" id="language_comborow">
                <property name="title" translatable="yes">Language</property>
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item translatable="yes" comments="This refers to using the system's default language.">Default</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="color_scheme_comborow">
                <property name="title" translatable="yes">Color Scheme</property>
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item translatable="yes" comments="Translators: This refers to using the system default color scheme.">Default</item>
                      <item translatable="yes" comments="Translators: This refers to using a light variant of the color scheme.">Light</item>
                      <item translatable="yes" comments="Translators: This refers to using a dark variant of the color scheme.">Dark</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="menubar_switchrow">
                <property name="title" translatable="yes">Show Menu Bar</property>
                <property name="subtitle" translatable="yes">Replaces the header bar with a separate menu bar and tool bar.</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Canvas</property>
            <child>
              <object class="AdwSwitchRow" id="selection_anim_switchrow">
                <property name="title" translatable="yes">Animate Selection Outline</property>
                <property name="subtitle" translatable="yes">Enables a "marching ants" effect to improve the selection's visibility. Disable to reduce CPU usage.</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Startup Image</property>
            <child>
              <object class="AdwSpinRow" id="startup_width_spinrow">
                <property name="title" translatable="yes">Width</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">1</property>
                    <property name="upper">10000</property>
                    <property name="step-increment">1</property>
                    <property name="page-increment">10</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwSpinRow" id="startup_height_spinrow">
                <property name="title" translatable="yes">Height</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">1</property>
                    <property name="upper">10000</property>
                    <property name="step-increment">1</property>
                    <property name="page-increment">10</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="startup_background_comborow">
                <property name="title" translatable="yes">Background</property>
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item translatable="yes" comments="Translators: Background option for the image created at startup.">White</item>
                      <item translatable="yes" comments="Translators: Background option for the image created at startup.">Transparent</item>
                      <item translatable="yes" comments="Translators: Background option for the image created at startup, using a chosen color.">Custom</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwActionRow" id="startup_color_row">
                <property name="title" translatable="yes">Color</property>
                <property name="visible">False</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
